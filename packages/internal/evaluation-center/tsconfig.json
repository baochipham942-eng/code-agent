{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["../../../src/*"],
      "@host/*": ["../../../src/host/*"],
      "@renderer/*": ["../../../src/renderer/*"],
      "@shared/*": ["../../../src/shared/*"],
      "electron": ["../../../src/host/platform/index.ts"]
    }
  },
  "include": [
    "../../../src/**/*.d.ts",
    "*.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts"
  ]
}
