FROM node:24-bookworm

ARG CODEX_VERSION=0.151.0
ARG KIMI_VERSION=0.39.1
ARG GROK_VERSION=1.0.13

ENV PATH="/root/.grok/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global \
      "@openai/codex@${CODEX_VERSION}" \
      "@moonshot-ai/kimi-code@${KIMI_VERSION}" \
    && curl -fsSL https://x.ai/cli/install.sh | bash -s "${GROK_VERSION}" \
    && codex --version \
    && kimi --version \
    && grok --version

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/rebuild-native-system.sh ./scripts/rebuild-native-system.sh

RUN npm_config_cache=/tmp/npm-cache npm ci --legacy-peer-deps \
    && rm -rf /tmp/npm-cache

COPY . /app

RUN npm run build:cli

CMD ["tail", "-f", "/dev/null"]
