        "scripts/perf/journey-probe-protocol.ts",
        "scripts/perf/journey-probe-instrument.tsx",
        "scripts/perf/journey-probe-test-support.ts",
        "scripts/perf-journey-ratchet.mjs",
        "scripts/perf-journey-ratchet-baseline.json"
