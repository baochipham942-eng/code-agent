  "sharedPackageInputs": [
    "src/shared/**",
    "tsconfig*.json",
    "package.json",
    "package-lock.json"
  ],
  "packages": [
    "packages/eval-harness",
    "packages/internal/evaluation-center",
    "vercel-api"
  ],
  "testsTypecheckInputs": [
    "tests/**",
    "scripts/**",
    "tsconfig*.json"
  ],
  "budgetsMs": {
    "inputs": 10000,
    "provider": 10000,
    "private": 30000,
    "src-typecheck": 45000,
    "shell": 10000,
    "commit-checks": 45000,
    "vitest": 90000,
    "package-typechecks": 45000,
    "tests-typecheck": 45000
  }
}
